SHELLX_DRIVE_BIND=127.0.0.1:5758
SHELLX_DRIVE_DATA_DIR=/var/lib/shellx-drive
# Exact HTTPS browser origin for email links and cookie Origin checks. Configure
# its TLS reverse proxy before browser use; do not expose the loopback service.
SHELLX_DRIVE_PUBLIC_ORIGIN=https://drive.example.com
# Optional public GitHub owner/repo used for update checks. Disabled until a
# deployment deliberately assigns its release coordinate.
SHELLX_DRIVE_UPDATE_REPO=
# REQUIRED: replace with a strong random secret of at least 16 characters.
# Generate one with:  openssl rand -hex 32
# Provide a unique, non-placeholder token of at least 16 characters.
# For disposable local testing, --e2e enables the guarded debug test helpers.
SHELLX_DRIVE_TOKEN=REPLACE_WITH_A_STRONG_RANDOM_TOKEN
# Optional separate first-admin authority. The systemd package installer
# generates this automatically; manual deployments should generate it independently.
SHELLX_DRIVE_BOOTSTRAP_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_SETUP_TOKEN
SHELLX_DRIVE_BACKUP_MAX_ARCHIVE_BYTES=9895604649984
# Set to true only when a trusted reverse proxy is the sole loopback peer.
SHELLX_DRIVE_TRUST_PROXY_HEADERS=false
# Optional: local email/password browser session lifetime. Default is 30 days.
SHELLX_DRIVE_LOCAL_SESSION_TTL_SECONDS=2592000
# Emit ShellX Drive operational INFO, WARN, and ERROR events to the service log.
# This overrides the matching systemd default; use shellx_drive=debug only while triaging.
RUST_LOG=shellx_drive=info
