{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShellX Drive Desktop",
  "version": "0.1.13",
  "identifier": "com.shellx.drive.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ShellX Drive Desktop",
        "width": 620,
        "height": 700,
        "minWidth": 460,
        "minHeight": 560,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1REYxQjBENzU2NTc3MUQKUldRZGQyVjFEUnZmMVVXc0F1d2NsUytiRytDemwwOE9WOGI0dUxJeGp5Q084VStjOEZaamV3eWcK",
      "endpoints": [
        "https://github.com/martinsbrezauckis/shellx-drive/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
