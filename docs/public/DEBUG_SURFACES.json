{
  "schema_version": 1,
  "source_inventory": {
    "roots": ["src/server.rs", "src/routes"],
    "registration_pattern": ".route(<literal path>, ...)",
    "expected_unique_paths": 326
  },
  "classes": ["product", "admin", "debug", "agent", "exclusion"],
  "surfaces": [
    {
      "id": "ui-delivery",
      "description": "HTML shells, static browser assets, the service worker, and icons.",
      "oracle": {
        "kind": "exclusion",
        "reason": "These delivery routes do not mutate or expose Drive domain state; browser, CSP, asset, and UI contract tests are their owning evidence."
      }
    },
    {
      "id": "authentication",
      "description": "Bootstrap, sign-in, sessions, local credentials, 2FA, OIDC, and app-token administration.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/auth",
          "/debug/auth-attempts",
          "/debug/registration",
          "/debug/sessions",
          "/debug/app-tokens"
        ]
      }
    },
    {
      "id": "workspace-administration",
      "description": "Workspace lifecycle, membership, ownership, and server-wide workspace administration.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/workspaces",
          "/debug/receipts",
          "/debug/activity"
        ]
      }
    },
    {
      "id": "files",
      "description": "File and folder lifecycle, metadata, revisions, browsing trees, previews, and content operations.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/file-tree",
          "/debug/previews/{file_id}",
          "/debug/downloads",
          "/debug/receipts"
        ]
      }
    },
    {
      "id": "browse-search",
      "description": "Root views, recent/shared/starred listings, activity, and full-text search.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/browse",
          "/debug/search",
          "/debug/activity"
        ]
      }
    },
    {
      "id": "sharing",
      "description": "Managed and public guest shares, expiry, download policy, and share-derived capabilities.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/shares",
          "/debug/downloads",
          "/debug/receipts"
        ]
      }
    },
    {
      "id": "human-sharing",
      "description": "Item-scoped human grants, principal discovery, shared-root projections, canonical ownership inventory, and the server-controlled Everyone grant policy.",
      "oracle": {
        "kind": "indirect",
        "targets": [
          "/debug/receipts",
          "/debug/file-tree",
          "/debug/sync",
          "/debug/workspaces"
        ],
        "reason": "Human grants deliberately stay on authenticated product and administrator routes. The generic debug views expose redacted lifecycle, canonical-tree, sync, and workspace evidence without adding a raw per-principal debug or agent control surface."
      }
    },
    {
      "id": "drops",
      "description": "Managed Drops and public upload sessions.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/drops",
          "/debug/uploads",
          "/debug/receipts"
        ]
      }
    },
    {
      "id": "transfers",
      "description": "Upload, download, import, export, and archive transfer lifecycle.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/uploads",
          "/debug/downloads",
          "/debug/imports",
          "/debug/receipts"
        ]
      }
    },
    {
      "id": "sync",
      "description": "Desktop, mobile, delta, conflict, and offline sync state.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/sync",
          "/debug/sync/changes",
          "/debug/sync/conflicts",
          "/debug/delta-sync",
          "/debug/mobile-sync"
        ]
      }
    },
    {
      "id": "webdav",
      "description": "WebDAV file operations and lock state.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/webdav",
          "/debug/file-tree",
          "/debug/receipts"
        ]
      }
    },
    {
      "id": "office",
      "description": "Office handoff, package, edit-session, and save lifecycle.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/office-sessions",
          "/debug/file-tree",
          "/debug/receipts"
        ]
      }
    },
    {
      "id": "collaboration",
      "description": "Comments, replies, notifications, invitations, groups, and folder templates.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/comments",
          "/debug/notifications",
          "/debug/invitations",
          "/debug/groups",
          "/debug/folder-templates"
        ]
      }
    },
    {
      "id": "workspace-policy",
      "description": "Quota, retention, sharing defaults, and workspace usage policy.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/policies",
          "/debug/usage",
          "/debug/retention/preview"
        ]
      }
    },
    {
      "id": "hosted",
      "description": "Hosted and tenant posture.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/hosted",
          "/debug/registration"
        ]
      }
    },
    {
      "id": "google-compatibility",
      "description": "Google Drive-compatible file operations.",
      "oracle": {
        "kind": "indirect",
        "targets": [
          "/debug/receipts",
          "/debug/file-tree",
          "/debug/downloads"
        ],
        "reason": "Compatibility calls use the same file, content, receipt, and access-counter paths as native Drive operations. Separate protocol counters would duplicate state without adding an independent product oracle."
      }
    },
    {
      "id": "agent-access",
      "description": "Human-managed agent principals and grants plus the bounded agent-safe data plane.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/agent-access",
          "/debug/receipts",
          "/debug/file-tree"
        ]
      }
    },
    {
      "id": "desktop-agent-control",
      "description": "Owner-directed desktop device enrollment and bounded command broker protocol.",
      "oracle": {
        "kind": "indirect",
        "targets": [
          "/debug/receipts",
          "/debug/auth",
          "/debug/sessions"
        ],
        "reason": "Device credentials, leases, command payloads, and device state stay on the owner/device protocol. Redacted receipt and account-session views prove lifecycle and revocation without adding a second agent-control or credential-viewing debug surface."
      }
    },
    {
      "id": "file-access-statistics",
      "description": "Workspace preview and download counters.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/file-access",
          "/workspaces/{workspace_id}/file-statistics"
        ],
        "reason": "The debug route supplies redacted server-wide evidence; the manage-permission product route remains the detailed workspace oracle."
      }
    },
    {
      "id": "service-operations",
      "description": "Health, readiness, version, update, backup, maintenance, sandbox, support, and other server operations.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/state",
          "/debug/maintenance",
          "/debug/backups",
          "/debug/support-bundle",
          "/debug/storage-integrity"
        ]
      }
    },
    {
      "id": "debug-observability",
      "description": "Admin-only debug, deterministic E2E, and service-twin evidence.",
      "oracle": {
        "kind": "direct",
        "targets": [
          "/debug/state"
        ],
        "reason": "Each debug route overrides this surface default with itself as the direct oracle."
      }
    }
  ],
